node_modules
.next
.vercel

# environment files — never commit secrets
.env
.env*
!.env.example

# TypeScript incremental build cache — a generated artifact that churns on
# every tsc run and has no business in review diffs
tsconfig.tsbuildinfo

# raw AI-generated intro source — only processed assets in public/intro/ are committed
intro-raw.mp4

# Generated by Next.js — next-env.d.ts flip-flops between `next dev`
# (.next/dev/types) and `next build` (.next/types), so tracking it means a
# permanently dirty tree. Next regenerates it at the start of every build.
next-env.d.ts

# Scaffolded by `next dev` (generate-agent-files). Deliberately not tracked:
# framework-authored instructions should not silently shape how agents work
# in this repo. Ignored so regeneration does not dirty the tree.
AGENTS.md
CLAUDE.md
